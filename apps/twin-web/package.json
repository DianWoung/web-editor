{
  "name": "twin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:node && npm run test:pages",
    "test:node": "node --test --experimental-strip-types src/services/api/runtimeApi.test.ts src/store/runtimeStore.test.ts",
    "test:pages": "vitest run src/pages/runtimeIntegration.test.tsx src/store/editorUiStore.test.ts src/store/sceneStore.undo.test.ts src/pages/scenes/ScenesPage.test.tsx src/pages/scenes/ScenePreviewPage.test.tsx src/pages/editor/EditorPage.test.tsx src/pages/assets/AssetsPage.test.tsx src/components/panels/SceneJsonToolbar.test.tsx",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "echarts": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "three": "^0.183.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
